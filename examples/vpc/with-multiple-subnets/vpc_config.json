{
  "name": "multi-region-vpc",
  "project": "prj-05-vpc-16748",
  "description": "VPC with multiple subnets across different regions",
  "auto_create_subnetworks": false,
  "routing_mode": "REGIONAL",
  "delete_default_routes_on_create": false,
  "subnets": [
    {
      "name": "subnet-us-central",
      "region": "us-central1",
      "ip_cidr_range": "10.0.0.0/20",
      "description": "Primary subnet in us-central1",
      "private_ip_google_access": true,
      "secondary_ip_ranges": []
    },
    {
      "name": "subnet-us-east",
      "region": "us-east1",
      "ip_cidr_range": "10.1.0.0/20",
      "description": "Secondary subnet in us-east1",
      "private_ip_google_access": true,
      "secondary_ip_ranges": []
    },
    {
      "name": "subnet-europe-west",
      "region": "europe-west1",
      "ip_cidr_range": "10.2.0.0/20",
      "description": "Subnet in europe-west1",
      "private_ip_google_access": true,
      "secondary_ip_ranges": []
    }
  ]
}
